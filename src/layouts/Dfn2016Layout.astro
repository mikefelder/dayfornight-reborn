---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  bodyClass?: string;
  ogImage?: string;
}

const { title = 'Day for Night', bodyClass = 'home blog', ogImage } = Astro.props;
---

<BaseLayout title={title} ogImage={ogImage} bodyClass={bodyClass}>
  <Fragment slot="head">
    <link rel="stylesheet" href="/shared-assets/2016/css/style.css" />
  </Fragment>

  <slot />
</BaseLayout>
