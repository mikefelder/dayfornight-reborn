---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  bodyClass?: string;
}

const { title, description = 'Day For Night - light & sound collide', ogImage, bodyClass = '' } = Astro.props;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>{title}</title>
    <link rel="icon" href="/shared-assets/2015/images/favicon-dfn.png" type="image/png" />
    <meta property="og:title" content={title} />
    <meta property="og:site_name" content="Day For Night" />
    <meta property="og:type" content="article" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:site" content="@dayfornightfest" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <ClientRouter />
    <slot name="head" />
    <style is:global>
      /* Page transition: slideUp (matches original Flora theme) */
      @keyframes slide-up-out {
        from { transform: translateY(0); opacity: 1; }
        to { transform: translateY(-100vh); opacity: 0; }
      }
      @keyframes slide-up-in {
        from { transform: translateY(100vh); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
      }
      ::view-transition-old(root) {
        animation: slide-up-out 0.8s cubic-bezier(0.785, 0.135, 0.150, 0.860) both;
      }
      ::view-transition-new(root) {
        animation: slide-up-in 0.8s cubic-bezier(0.785, 0.135, 0.150, 0.860) both;
      }
    </style>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
