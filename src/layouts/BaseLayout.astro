---
import { ClientRouter } from 'astro:transitions';
import YearRotationPill from '@components/YearRotationPill.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  bodyClass?: string;
  // Set false to hide the year-navigation pill (e.g. on standalone pages).
  showYearPill?: boolean;
}

const {
  title,
  description = 'Day For Night - light & sound collide',
  ogImage,
  ogType = 'website',
  bodyClass = '',
  showYearPill = true,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.ico" sizes="any" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Day For Night" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:site" content="@dayfornightfest" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <ClientRouter />
    <slot name="head" />
    <style is:global>
      /* Page transition: slideUp (matches original Flora theme) */
      @keyframes slide-up-out {
        from { transform: translateY(0); opacity: 1; }
        to { transform: translateY(-100vh); opacity: 0; }
      }
      @keyframes slide-up-in {
        from { transform: translateY(100vh); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
      }
      ::view-transition-old(root) {
        animation: slide-up-out 0.8s cubic-bezier(0.785, 0.135, 0.150, 0.860) both;
      }
      ::view-transition-new(root) {
        animation: slide-up-in 0.8s cubic-bezier(0.785, 0.135, 0.150, 0.860) both;
      }
    </style>
  </head>
  <body class={bodyClass}>
    <slot />
    {showYearPill && <YearRotationPill />}
  </body>
</html>
