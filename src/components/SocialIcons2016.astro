---
import GitHubIcon from './GitHubIcon.astro';
import socialData from '@data/snapshot-2016.json';

const { socialLinks } = socialData;
---

<div class="social-icons">
  <ul>
    {socialLinks.map((s) => (
      <li class={s.platform}>
        <a target="_blank" rel="noopener noreferrer" href={s.url} aria-label={s.platform}>
          {s.platform === 'github' && (
            <GitHubIcon />
          )}
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .social-icons li.github {
    background: none;
    margin-left: 0;
    width: 20px;
  }

  .social-icons li.github a {
    text-indent: 0;
  }

  .social-icons li.github :global(svg) {
    display: block;
  }
</style>
