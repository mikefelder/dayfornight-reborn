---
import socialData from '@data/snapshot-2016.json';

const { socialLinks } = socialData;
---

<div class="social-icons">
  <ul>
    {socialLinks.map((s) => (
      <li class={s.platform}>
        <a target="_blank" rel="noopener noreferrer" href={s.url} aria-label={s.platform}>
          {s.platform === 'github' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" style="display:block; width:20px; height:20px;">
              <path fill="currentColor" d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.166 6.839 9.489.5.092.682-.217.682-.483 0-.237-.009-.868-.014-1.703-2.782.604-3.369-1.341-3.369-1.341-.455-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.004.071 1.532 1.031 1.532 1.031.892 1.529 2.341 1.088 2.91.832.091-.646.349-1.088.635-1.339-2.221-.253-4.556-1.111-4.556-4.943 0-1.092.39-1.985 1.029-2.685-.103-.253-.446-1.271.098-2.65 0 0 .84-.269 2.75 1.026A9.564 9.564 0 0 1 12 6.756a9.54 9.54 0 0 1 2.504.337c1.909-1.295 2.748-1.026 2.748-1.026.546 1.379.203 2.397.1 2.65.64.7 1.028 1.593 1.028 2.685 0 3.842-2.339 4.687-4.566 4.935.359.309.679.919.679 1.852 0 1.337-.012 2.417-.012 2.747 0 .269.18.58.688.481A10.001 10.001 0 0 0 22 12c0-5.523-4.477-10-10-10z" />
            </svg>
          )}
        </a>
      </li>
    ))}
  </ul>
</div>
