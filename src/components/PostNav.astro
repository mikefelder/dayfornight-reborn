---
import snapshotData from '@data/snapshot-2015.json';

interface NavArtist {
  slug: string;
  name: string;
}

interface Props {
  prevArtist?: NavArtist;
  nextArtist?: NavArtist;
}

const { prevArtist, nextArtist } = Astro.props;

const imageBySlug = new Map(
  snapshotData.gridOrder.map((item) => [item.slug, item.image.replace(/^images\//, '')])
);

function imageFor(artist: NavArtist): string {
  return imageBySlug.get(artist.slug) || `${artist.slug}-1600-640x500.jpg`;
}
---

<nav class="post-nav clear">
  {prevArtist?.slug && (
    <div class="prev-post">
      <a href={`/2015/artists/${prevArtist.slug}/`} rel="prev"></a>
      <div class="post-link clear">
        <span>
          <a href={`/2015/artists/${prevArtist.slug}/`} rel="prev">
            <img
              src={`/shared-assets/2015/images/${imageFor(prevArtist)}`}
              alt={prevArtist.name}
              class="post-thumb"
              loading="lazy"
            />
          </a>
        </span>
        <h4>
          <a href={`/2015/artists/${prevArtist.slug}/`} rel="prev">{prevArtist.name}</a>
        </h4>
      </div>
    </div>
  )}
  {nextArtist?.slug && (
    <div class="next-post">
      <a href={`/2015/artists/${nextArtist.slug}/`} rel="next"></a>
      <div class="post-link clear">
        <span>
          <a href={`/2015/artists/${nextArtist.slug}/`} rel="next">
            <img
              src={`/shared-assets/2015/images/${imageFor(nextArtist)}`}
              alt={nextArtist.name}
              class="post-thumb"
              loading="lazy"
            />
          </a>
        </span>
        <h4>
          <a href={`/2015/artists/${nextArtist.slug}/`} rel="next">{nextArtist.name}</a>
        </h4>
      </div>
    </div>
  )}
  <div class="nav-home">
    <a href="/2015/"><i class="flora-icon-th"></i></a>
  </div>
</nav>
