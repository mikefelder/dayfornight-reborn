---
interface Props {
  era?: 'flora' | 'dfn2016' | 'dfn2017' | 'presale2017';
}

const { era = 'dfn2017' } = Astro.props;
---

<aside class={`work-order-attribution work-order-attribution--${era}`} aria-label="Day for Night origin attribution">
  <a href="https://work-order.co" target="_blank" rel="noopener noreferrer">
    <span class="wo-kicker">Cofounded &amp; designed by</span>
    <span class="wo-name">Work-Order</span>
    <span class="wo-mark" aria-hidden="true">↗</span>
  </a>
</aside>

<style>
  .work-order-attribution {
    box-sizing: border-box;
    width: 100%;
    text-align: center;
  }

  .work-order-attribution a {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.055em;
  }

  .wo-kicker {
    opacity: 0.72;
  }

  .wo-name {
    font-weight: 700;
  }

  .wo-mark {
    display: inline-block;
    transition: transform 180ms ease;
  }

  .work-order-attribution a:hover .wo-mark {
    transform: translate(2px, -2px);
  }

  .work-order-attribution--flora {
    padding: 14px 20px 22px;
    background: #050505;
    font-family: 'GT-Cinetype-Regular', Arial, sans-serif;
    font-size: 9px;
  }

  .work-order-attribution--flora a {
    color: #cfcfcf;
    border: 1px solid rgba(255, 255, 255, 0.18);
    padding: 7px 11px;
  }

  .work-order-attribution--flora a:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.44);
  }

  .work-order-attribution--dfn2016 {
    padding: 22px 16px;
    font-family: 'GT-Cinetype', Arial, sans-serif;
    font-size: 8px;
  }

  :global(body.mode-day1) .work-order-attribution--dfn2016,
  :global(body.mode-day2) .work-order-attribution--dfn2016 {
    color: #f7931e;
  }

  :global(body.mode-night1) .work-order-attribution--dfn2016,
  :global(body.mode-night2) .work-order-attribution--dfn2016 {
    color: #00ffff;
  }

  .work-order-attribution--dfn2016 a {
    color: currentColor;
    border: 1px solid currentColor;
    padding: 6px 10px;
  }

  .work-order-attribution--dfn2017 {
    padding: 20px 16px 84px;
    color: #ff212b;
    font-family: 'GT-Cinetype', Arial, sans-serif;
    font-size: 8px;
  }

  :global(body.mode-night) .work-order-attribution--dfn2017,
  :global(body.mode-night1) .work-order-attribution--dfn2017,
  :global(body.mode-night2) .work-order-attribution--dfn2017 {
    color: #0168ff;
  }

  :global(body.mode-day) .work-order-attribution--dfn2017,
  :global(body.mode-day1) .work-order-attribution--dfn2017,
  :global(body.mode-day2) .work-order-attribution--dfn2017 {
    color: #ff212b;
  }

  .work-order-attribution--dfn2017 a {
    color: inherit;
    border: 1px solid currentColor;
    padding: 6px 10px;
  }

  .work-order-attribution--presale2017 {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18px;
    z-index: 4;
    color: #ec352f;
    font-family: 'GT-Cinetype', Arial, sans-serif;
    font-size: 8px;
  }

  .work-order-attribution--presale2017 a {
    color: inherit;
    background: rgba(0, 0, 0, 0.78);
    border: 1px solid currentColor;
    box-shadow: 0 0 18px rgba(236, 53, 47, 0.18);
    padding: 6px 10px;
  }

  @media (max-width: 600px) {
    .work-order-attribution a {
      gap: 0.35em;
      letter-spacing: 0.035em;
    }

    .work-order-attribution--dfn2017 {
      padding-bottom: 70px;
    }
  }
</style>