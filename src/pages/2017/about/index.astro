---
import Dfn2017Layout from '@layouts/Dfn2017Layout.astro';
import aboutHtml from '@data/about-2017.html?raw';

const aboutContent = aboutHtml
  .split(/<footer>/i)[0]
  .replaceAll('/shared-assets/2017/images/2017/01/', '/shared-assets/2017/images/')
  .replaceAll('/shared-assets/2017/images/2016/08/', '/shared-assets/2017/images/')
  .replaceAll('/2017/sound/laurie-anderson/', '/2017/talks/laurie-anderson/');
---

<Dfn2017Layout
  title="About"
  titleSpan="About"
  bodyClass="page-template-default page page-id-21 no-tick mode-day radio-on page-about"
  dataSection="about"
  dataNav="about"
>
  <Fragment set:html={aboutContent} />
</Dfn2017Layout>
