---
import Dfn2016LineupLayout from '@layouts/Dfn2016LineupLayout.astro';
import snapshot from '@data/snapshot-2016-recap.json';

const IMG = '/shared-assets/2016/images';
const { tagline, quote, video, nav, social, newsletter, installationImages, sponsors, footer, dateData } = snapshot;
---

<Dfn2016LineupLayout bodyClass="home page-template-default page page-id-5 no-tick page-homepage">
  <span class="gradientBG"></span>
  <div id="container">
    <header id="header">
      <h1 id="main-title">
        <a href="/2016/recap/">
          <svg role="img" class="stroke c1" viewBox="0 0 190 190" x="0px" y="0px" width="190px" height="190px"><use xlink:href={`${IMG}/logo-layers.svg#stroke`}></use></svg>
          <svg role="img" class="half c1" viewBox="0 0 190 190" x="0px" y="0px" width="190px" height="190px"><use xlink:href={`${IMG}/logo-layers.svg#half`}></use></svg>
          <svg role="img" class="dropped c1" viewBox="0 0 190 190" x="0px" y="0px" width="190px" height="190px"><use xlink:href={`${IMG}/logo-layers.svg#dropped`}></use></svg>
          <svg role="img" class="d c1" viewBox="0 0 190 190" x="0px" y="0px" width="190px" height="190px"><use xlink:href={`${IMG}/logo-layers.svg#d`}></use></svg>
          <svg role="img" class="fn c0" viewBox="0 0 190 190" x="0px" y="0px" width="190px" height="190px"><use xlink:href={`${IMG}/logo-layers.svg#fn`}></use></svg>
        </a>
      </h1>
    </header>

    <div class="nav-items">
      <ul id="menu-main-menu" class="menu">
        {nav.map((item) => (
          <li class={`menu-item${item.children ? ' menu-item-has-children' : ''}${item.label.includes('Lineup') ? ' lineup-link' : ''}`}>
            <a href={item.href}>{item.label}</a>
            {item.children && (
              <ul class="sub-menu">
                {item.children.map((child) => (
                  <li class={`menu-item${child.label === 'Sound' ? ' sound-link' : ''}${child.label === 'Light' ? ' light-link' : ''}`}>
                    <a href={child.href}>{child.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <span class="menu-toggle mobile-only"></span>
    </div>

    <div class="social-sidebar">
      {social.map((s) => (
        <a href={s.url} class="social-link" target="_blank" rel="noopener noreferrer">
          <svg role="img" class={s.platform} viewBox="0 0 36 36" x="0px" y="0px" width="36px" height="36px"><use xlink:href={`${IMG}/social.svg#${s.platform}`}></use></svg>
        </a>
      ))}
      <a href={newsletter.action} class="mailing-list-toggle newsletter-link caption" target="_blank" rel="noopener noreferrer">{newsletter.label}</a>
    </div>

    <div id="main" role="main">
      <div class="home-quote-wrap bbox">
        <h1 class="home-quote o1 display3">
          <span class="span-1" dub="&ldquo;">&ldquo;</span>
          {quote.text.split(' ').map((word, i) => (
            <span class={`span-${i + 2}`} dub={word}>{word}</span>
          ))}
          {' '}
          <span class={`span-${quote.text.split(' ').length + 2}`} dub="&rdquo;">&rdquo;</span>
          <small>{quote.source}</small>
        </h1>
      </div>

      <div class="mainVid">
        <div class="vid-pad" style="position:relative; width:100%; height:0; padding-bottom:56.25%;">
          <iframe
            src={`https://player.vimeo.com/video/${video.vimeoId}?color=f7931e&title=0&byline=0&portrait=0`}
            style="position:absolute; top:0; left:0; width:100%; height:100%;"
            frameborder="0"
            allowfullscreen
          ></iframe>
        </div>
      </div>

      <div class="home-section intro-section">
        <div class="section-text">
          <h2>{tagline}</h2>
        </div>
      </div>

      <div class="light-media o1">
        {installationImages.map((img) => (
          <img
            src={`${IMG}/${img.large}`}
            alt=""
            loading="lazy"
            style="display:block; max-width:100%; height:auto; margin-bottom:20px;"
          />
        ))}
      </div>

      <div class="sponsor-section homepage-sponsor-section">
        <div class="sponsor-list tier-1">
          {sponsors.map((sponsor) => (
            <div class="single-sponsor" style={`max-width:${sponsor.maxWidth};`}>
              <img src={`${IMG}/${sponsor.image}`} alt={sponsor.name} />
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="container-footer"></div>
  </div>

  <footer>
    <a href={footer.contactUrl}>Contact</a>
  </footer>

  <div class="modal-bg"></div>
  <div class="modal modal-mailinglist bbox">
    <span class="close">Close</span>
    <div class="form-subscribe form-inline bbox">
      <p>Enter your email address to get updates</p>
      <div id="mc_embed_signup">
        <form
          action={newsletter.action}
          method="post"
          id="mc-embedded-subscribe-form"
          name="mc-embedded-subscribe-form"
          class="validate"
          target="_blank"
          novalidate
        >
          <div id="mc_embed_signup_scroll">
            <div class="mc-field-group">
              <input type="email" value="" name="EMAIL" class="required email bbox" id="mce-EMAIL" />
              <button class="btn" type="submit" id="mc-embedded-subscribe">&rarr;</button>
            </div>
            <div id="mce-responses" class="clear">
              <div class="response" id="mce-error-response" style="display:none"></div>
              <div class="response" id="mce-success-response" style="display:none"></div>
            </div>
            <div style="position: absolute; left: -5000px;" aria-hidden="true">
              <input type="text" name="b_2f0646d01369ed754c53fb8a3_a04eff96cd" tabindex="-1" value="" />
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script define:vars={{ dateData }}>
    // Time-of-day gradient system — reimplemented from project.js
    const sunlight = '#f7931e';
    const twilight = '#00ffff';

    function doDateDisplay() {
      const today = new Date();
      const dd = String(today.getDate()).padStart(2, '0');
      const mm = String(today.getMonth() + 1).padStart(2, '0');
      const yyyy = String(today.getFullYear());

      let currDay = dateData.find(d => d[0] === mm && d[1] === dd && d[2] === yyyy);
      if (!currDay) {
        currDay = dateData.find(d => d[0] === '12' && d[1] === '17') || dateData[dateData.length - 1];
      }

      const sunrise = currDay[3].split(':');
      const sunset = currDay[4].split(':');
      const date1 = new Date(+currDay[2], +currDay[0] - 1, +currDay[1], +sunrise[0], +sunrise[1]);
      const date2 = new Date(+currDay[2], +currDay[0] - 1, +currDay[1], +sunset[0], +sunset[1]);
      const rightNow = new Date();
      const simNow = new Date(+currDay[2], +currDay[0] - 1, +currDay[1], rightNow.getHours(), rightNow.getMinutes(), rightNow.getSeconds());

      const dayLength = date2 - date1;
      const nightLength = 86400000 - dayLength;

      let displayMode = '';
      let percComplete = 0;

      if (date1 > simNow) {
        percComplete = ((nightLength - (date1 - simNow)) / nightLength).toFixed(4);
        displayMode = percComplete >= 0.5 ? 'night2' : 'night1';
      } else if (date1 < simNow && date2 > simNow) {
        percComplete = ((simNow - date1) / dayLength).toFixed(4);
        displayMode = percComplete >= 0.5 ? 'day2' : 'day1';
      } else {
        percComplete = ((simNow - date2) / nightLength).toFixed(4);
        displayMode = percComplete >= 0.5 ? 'night2' : 'night1';
      }

      document.body.classList.remove('mode-night1', 'mode-day1', 'mode-night2', 'mode-day2');
      document.body.classList.add('mode-' + displayMode);
      updateSky(displayMode, percComplete);
    }

    function updateSky(mode, perc) {
      if (perc < 1) perc = (perc * 100).toFixed(4);

      let skyUp = '';
      if ((mode === 'night1' || mode === 'night2') && perc >= 50 && perc < 95) {
        skyUp = 'black ' + perc + '%, ' + twilight + ' 100%';
      } else if ((mode === 'night1' || mode === 'night2') && perc < 50) {
        skyUp = twilight + ' 0%, black ' + perc + '%';
      } else if ((mode === 'night1' || mode === 'night2') && perc >= 95) {
        skyUp = sunlight + ' 0%, black ' + Math.abs(5 - (100 - perc)) + '%, black ' + perc + '%, ' + twilight + ' 100%';
      } else if ((mode === 'day1' || mode === 'day2') && perc >= 50 && perc < 95) {
        skyUp = 'black ' + perc + '%, ' + sunlight + ' 100%';
      } else if ((mode === 'day1' || mode === 'day2') && perc < 50) {
        skyUp = sunlight + ' 0%, black ' + perc + '%';
      } else if ((mode === 'day1' || mode === 'day2') && perc >= 95) {
        skyUp = twilight + ' 0%, black ' + Math.abs(5 - (100 - perc)) + '%, black ' + perc + '%, ' + sunlight + ' 100%';
      }

      if (window.innerWidth > 670) {
        const gradEl = document.querySelector('.gradientBG');
        if (gradEl && skyUp) {
          gradEl.style.backgroundImage = 'linear-gradient(to right, ' + skyUp + ')';
        }
      }
    }

    doDateDisplay();
    setInterval(doDateDisplay, 10000);

    // Mobile menu toggle
    document.addEventListener('DOMContentLoaded', () => {
      const toggle = document.querySelector('.menu-toggle');
      if (toggle) {
        toggle.addEventListener('click', () => {
          document.body.classList.toggle('menu-on');
        });
      }

      // Newsletter modal
      const mlToggle = document.querySelector('.mailing-list-toggle');
      const modalBg = document.querySelector('.modal-bg');
      const modalClose = document.querySelector('.modal-mailinglist .close');
      if (mlToggle) {
        mlToggle.addEventListener('click', (e) => {
          e.preventDefault();
          document.body.classList.add('modal-on');
        });
      }
      if (modalBg) {
        modalBg.addEventListener('click', () => {
          document.body.classList.remove('modal-on', 'gallery-on');
        });
      }
      if (modalClose) {
        modalClose.addEventListener('click', () => {
          document.body.classList.remove('modal-on');
        });
      }

      // Video cover click -> embed player
      const vidCover = document.querySelector('.vid-cover');
      if (vidCover) {
        vidCover.addEventListener('click', () => {
          const id = vidCover.getAttribute('data-id');
          const iframe = document.createElement('iframe');
          iframe.src = `https://player.vimeo.com/video/${id}?color=f7931e&title=0&byline=0&portrait=0&autoplay=1`;
          iframe.setAttribute('frameborder', '0');
          iframe.setAttribute('allowfullscreen', '');
          iframe.style.width = '100%';
          iframe.style.height = '100%';
          iframe.style.position = 'absolute';
          iframe.style.top = '0';
          iframe.style.left = '0';
          vidCover.innerHTML = '';
          vidCover.style.paddingBottom = '56.25%';
          vidCover.style.position = 'relative';
          vidCover.appendChild(iframe);
        });
      }
    });
  </script>
</Dfn2016LineupLayout>
