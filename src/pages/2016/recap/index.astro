---
import Dfn2016LineupLayout from '@layouts/Dfn2016LineupLayout.astro';
import snapshot from '@data/snapshot-2016-recap.json';

const IMG = '/shared-assets/2016/images';
const { tagline, quote, video, nav, social, newsletter, sponsors, footer } = snapshot;
---

<Dfn2016LineupLayout bodyClass="home page-template-default page page-id-5 no-tick page-homepage">
  <style>
    .home-quote-wrap {
      margin-bottom: 30px;
      padding-right: 18px;
      max-width: 1360px;
    }
    @media (min-width: 670px) {
      .home-quote-wrap {
        margin-bottom: 0;
        min-height: 280px;
        padding: 40px 0 0;
      }
    }
    .home-quote {
      margin: 0;
      text-transform: uppercase;
      overflow-wrap: break-word;
      word-wrap: break-word;
    }
    .home-quote small {
      font-size: 14px;
      letter-spacing: 0.06em;
      display: block;
      margin-top: 12px;
    }
    .home-quote small::before {
      content: "\a0\2014\a0";
    }
    @media (min-width: 670px) {
      .home-quote small {
        display: inline-block;
        vertical-align: middle;
        margin-top: 0;
      }
    }
    @media (min-width: 1400px) {
      .home-quote {
        font-size: 76px;
        line-height: 84px;
        letter-spacing: 0.1em;
      }
    }
  </style>
  <span class="gradientBG"></span>
  <div id="container">
    <header id="header">
      <h1 id="main-title">
        <a href="/2016/recap/">
          <svg role="img" class="stroke c1" viewBox="0 0 190 190" x="0px" y="0px" width="190px" height="190px"><use xlink:href={`${IMG}/logo-layers.svg#stroke`}></use></svg>
          <svg role="img" class="half c1" viewBox="0 0 190 190" x="0px" y="0px" width="190px" height="190px"><use xlink:href={`${IMG}/logo-layers.svg#half`}></use></svg>
          <svg role="img" class="dropped c1" viewBox="0 0 190 190" x="0px" y="0px" width="190px" height="190px"><use xlink:href={`${IMG}/logo-layers.svg#dropped`}></use></svg>
          <svg role="img" class="d c1" viewBox="0 0 190 190" x="0px" y="0px" width="190px" height="190px"><use xlink:href={`${IMG}/logo-layers.svg#d`}></use></svg>
          <svg role="img" class="fn c0" viewBox="0 0 190 190" x="0px" y="0px" width="190px" height="190px"><use xlink:href={`${IMG}/logo-layers.svg#fn`}></use></svg>
        </a>
      </h1>
    </header>

    <div class="nav-items">
      <ul id="menu-main-menu" class="menu">
        {nav.map((item) => (
          <li class={`menu-item${item.children ? ' menu-item-has-children' : ''}${item.label.includes('Lineup') ? ' lineup-link' : ''}`}>
            {item.href === '#' ? <a>{item.label}</a> : <a href={item.href}>{item.label}</a>}
            {item.children && (
              <ul class="sub-menu">
                {item.children.map((child) => (
                  <li class={`menu-item${child.label === 'Sound' ? ' sound-link' : ''}${child.label === 'Light' ? ' light-link' : ''}`}>
                    {child.href === '#' ? <a>{child.label}</a> : <a href={child.href}>{child.label}</a>}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <span class="menu-toggle mobile-only"></span>
    </div>

    <div class="social-sidebar">
      {social.map((s) => (
        <a href={s.url} class="social-link" target="_blank" rel="noopener noreferrer">
          <svg role="img" class={s.platform} viewBox="0 0 36 36" x="0px" y="0px" width="36px" height="36px"><use xlink:href={`${IMG}/social.svg#${s.platform}`}></use></svg>
        </a>
      ))}
      <a href={newsletter.action} class="mailing-list-toggle newsletter-link caption" target="_blank" rel="noopener noreferrer">{newsletter.label}</a>
    </div>

    <div id="main" role="main">
      <div class="home-quote-wrap bbox">
        <h1 class="home-quote o1 display3">
          &ldquo;{quote.text}&rdquo;
          <small>{quote.source}</small>
        </h1>
      </div>

      <div class="mainVid">
        <div class="vid-pad" style="position:relative; width:100%; height:0; padding-bottom:56.25%;">
          <iframe
            src={`https://player.vimeo.com/video/${video.vimeoId}?color=f7931e&title=0&byline=0&portrait=0`}
            style="position:absolute; top:0; left:0; width:100%; height:100%;"
            frameborder="0"
            allowfullscreen
          ></iframe>
        </div>
      </div>

      <div class="home-section intro-section">
        <div class="section-text">
          <h2>{tagline}</h2>
        </div>
      </div>

      <div id="sponsors" class="sponsor-section homepage-sponsor-section">
        <div class="sponsor-list tier-1">
          {sponsors.map((sponsor) => (
            <div class="single-sponsor" style={`max-width:${sponsor.maxWidth};`}>
              <img src={`${IMG}/${sponsor.image}`} alt={sponsor.name} />
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="container-footer"></div>
  </div>

  <footer>
    <a href={footer.contactUrl}>Contact</a>
  </footer>

  <div class="modal-bg"></div>
  <div class="modal modal-mailinglist bbox">
    <span class="close">Close</span>
    <div class="form-subscribe form-inline bbox">
      <p>Enter your email address to get updates</p>
      <div id="mc_embed_signup">
        <form
          action={newsletter.action}
          method="post"
          id="mc-embedded-subscribe-form"
          name="mc-embedded-subscribe-form"
          class="validate"
          target="_blank"
          novalidate
        >
          <div id="mc_embed_signup_scroll">
            <div class="mc-field-group">
              <input type="email" value="" name="EMAIL" class="required email bbox" id="mce-EMAIL" />
              <button class="btn" type="submit" id="mc-embedded-subscribe">&rarr;</button>
            </div>
            <div id="mce-responses" class="clear">
              <div class="response" id="mce-error-response" style="display:none"></div>
              <div class="response" id="mce-success-response" style="display:none"></div>
            </div>
            <div style="position: absolute; left: -5000px;" aria-hidden="true">
              <input type="text" name="b_2f0646d01369ed754c53fb8a3_a04eff96cd" tabindex="-1" value="" />
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

</Dfn2016LineupLayout>
