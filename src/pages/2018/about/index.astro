---
import Dfn2018Layout from '@layouts/Dfn2018Layout.astro';
import aboutHtml from '@data/about-2018.html?raw';
import { swapVimeoIframes } from '@data/videos';

const aboutContent = swapVimeoIframes(aboutHtml
  .split(/<footer>/i)[0]
  .replace(/\/wp-content\/uploads\/(?:2017\/01|2016\/08)\//g, '/shared-assets/2017/images/')
  .replaceAll('href="./lineup/"', 'href="/2018/lineup/"')
  .replace(/href="\.\/(sound|light|talks)\//g, 'href="/2018/$1/'), 2017);
---

<Dfn2018Layout
  title="About"
  titleSpan="About"
  bodyClass="page-template-default page page-id-17 no-tick mode-day radio-on page-about-day-for-night"
  dataSection="about"
  dataNav="about"
>
  <Fragment set:html={aboutContent} />
</Dfn2018Layout>
