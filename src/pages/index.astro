---
// Root page — randomly serves one of the year snapshots in a seamless iframe
const snapshots = [
  '/2015/',
  '/2015/splash/',
  '/2015/recap/',
];
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Day for Night</title>
  <meta name="description" content="Day for Night — Light & Sound Collide." />
  <style>
    html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }
    iframe { border: none; width: 100%; height: 100%; display: block; }
  </style>
</head>
<body>
  <iframe id="frame" title="Day for Night"></iframe>
  <script define:vars={{ snapshots }}>
    document.getElementById('frame').src = snapshots[Math.floor(Math.random() * snapshots.length)];
  </script>
</body>
</html>
