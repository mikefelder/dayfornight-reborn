---
// Root page — randomly serves one of the year snapshots inline
const snapshots = [
  // 2015: splash, full Flora lineup, post-show recap
  '/2015/',
  '/2015/splash/',
  '/2015/recap/',
  // 2016: blind presale, full lineup/main show, post-show recap
  '/2016/',
  '/2016/lineup/',
  '/2016/recap/',
  // 2017: presale and main show; subpages are reachable from nav
  '/2017/presale/',
  '/2017/',
  // 2018: late/post-2017 capture
  '/2018/',
];
---

<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Day for Night</title>
  <meta name="description" content="Day For Night — a music and arts festival in Houston, Texas featuring light and sound. Explore the 2015, 2016, 2017, and 2018 editions." />
  <link rel="canonical" href="https://dayfornight.dev/" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/favicon.ico" sizes="any" />
  <meta property="og:title" content="Day for Night" />
  <meta property="og:description" content="Day For Night — a music and arts festival in Houston, Texas featuring light and sound. Explore the 2015, 2016, 2017, and 2018 editions." />
  <meta property="og:site_name" content="Day For Night" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://dayfornight.dev/" />
  <meta name="twitter:site" content="@dayfornightfest" />
  <meta name="twitter:title" content="Day for Night" />
  <meta name="twitter:description" content="Day For Night — a music and arts festival in Houston, Texas featuring light and sound. Explore the 2015, 2016, 2017, and 2018 editions." />
  <meta name="twitter:card" content="summary_large_image" />
</head>
<body>
  <noscript>
    <nav>
      <ul>
        <li><a href="/2018/">Day for Night 2018</a></li>
        <li><a href="/2017/">Day for Night 2017</a></li>
        <li><a href="/2016/">Day for Night 2016</a></li>
        <li><a href="/2015/">Day for Night 2015</a></li>
      </ul>
    </nav>
  </noscript>
  <script define:vars={{ snapshots }}>
    const storageKey = 'dfn:snapshot-seen-at-session';
    const cooldownMs = 20 * 60 * 1000;
    const now = Date.now();

    let seenAt = {};
    try {
      const parsed = JSON.parse(sessionStorage.getItem(storageKey) || '{}');
      if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
        seenAt = parsed;
      }
    } catch {
      seenAt = {};
    }

    const candidates = snapshots.filter((s) => {
      const lastSeen = Number(seenAt[s] || 0);
      return now - lastSeen >= cooldownMs;
    });

    // If all snapshots are still in cooldown, pick the least-recently-seen one.
    const fallbackPool = [...snapshots].sort((a, b) => {
      const aSeen = Number(seenAt[a] || 0);
      const bSeen = Number(seenAt[b] || 0);
      return aSeen - bSeen;
    });

    const pool = candidates.length > 0 ? candidates : fallbackPool.slice(0, 1);
    const target = pool[Math.floor(Math.random() * pool.length)];

    seenAt[target] = now;
    sessionStorage.setItem(storageKey, JSON.stringify(seenAt));

    fetch(target)
      .then(r => r.text())
      .then(html => {
        // Inject <base> so relative asset paths resolve against the snapshot's directory
        const baseTag = '<base href="' + target + '">';
        html = html.replace(/<head([^>]*)>/i, '<head$1>' + baseTag);
        document.open();
        document.write(html);
        document.close();
        history.replaceState(null, '', '/');
      });
  </script>
</body>
</html>
