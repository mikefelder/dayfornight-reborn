---
// Root page — randomly serves one of the year snapshots inline
const snapshots = [
  '/2015/',
  '/2015/splash/',
  '/2015/recap/',
];
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Day for Night</title>
</head>
<body>
  <script define:vars={{ snapshots }}>
    const target = snapshots[Math.floor(Math.random() * snapshots.length)];
    fetch(target)
      .then(r => r.text())
      .then(html => {
        document.open();
        document.write(html);
        document.close();
        history.replaceState(null, '', '/');
      });
  </script>
</body>
</html>
