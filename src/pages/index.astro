---
// Root page — randomly serves one of the year snapshots inline
const snapshots = [
  '/2015/',
  '/2015/splash/',
  '/2015/recap/',
  '/2016/',
];
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Day for Night</title>
</head>
<body>
  <script define:vars={{ snapshots }}>
    const storageKey = 'dfn:last-snapshot';
    const historySize = 3;

    let recent = [];
    try {
      recent = JSON.parse(localStorage.getItem(storageKey) || '[]');
      if (!Array.isArray(recent)) recent = [];
    } catch {
      recent = [];
    }

    const recentSet = new Set(recent);
    const candidates = snapshots.filter((s) => !recentSet.has(s));
    const pool = candidates.length > 0 ? candidates : snapshots;
    const target = pool[Math.floor(Math.random() * pool.length)];

    const nextRecent = [target, ...recent.filter((s) => s !== target)].slice(0, historySize);
    localStorage.setItem(storageKey, JSON.stringify(nextRecent));

    fetch(target)
      .then(r => r.text())
      .then(html => {
        // Inject <base> so relative asset paths resolve against the snapshot's directory
        const baseTag = '<base href="' + target + '">';
        html = html.replace(/<head([^>]*)>/i, '<head$1>' + baseTag);
        document.open();
        document.write(html);
        document.close();
        history.replaceState(null, '', '/');
      });
  </script>
</body>
</html>
