---

<Flora2015Layout title="Schedule" bodyClass="page classic-nav no-title">
  <div class="main-content full-width header-space">
    <div class="page-background" style="background-color: #ffffff;"></div>
    <section class="w-section s-padding">
      <div class="container">
        <div class="row">
          <div class="col col-12">
            <div class="schedule-tabs">
              <nav class="schedule-tabs__nav">
                <button class="schedule-tab active" data-day="saturday">Saturday Dec. 19</button>
                <button class="schedule-tab" data-day="sunday">Sunday Dec. 20</button>
              </nav>

              <div class="schedule-day active" id="saturday">
                <div class="schedule-grid">
                  <div class="schedule-stage">
                    <h3 class="stage-header stage-header--red">Red Stage</h3>
                    {saturday.red.map((set) => (
                      <div class="schedule-event">
                        <span class="event-artist">{set.artist}</span>
                        <span class="event-time">{set.start} – {set.end}</span>
                      </div>
                    ))}
                  </div>
                  <div class="schedule-stage">
                    <h3 class="stage-header stage-header--green">Green Stage</h3>
                    {saturday.green.map((set) => (
                      <div class="schedule-event">
                        <span class="event-artist">{set.artist}</span>
                        <span class="event-time">{set.start} – {set.end}</span>
                      </div>
                    ))}
                  </div>
                  <div class="schedule-stage">
                    <h3 class="stage-header stage-header--blue">Blue Stage</h3>
                    {saturday.blue.map((set) => (
                      <div class="schedule-event">
                        <span class="event-artist">{set.artist}</span>
                        <span class="event-time">{set.start} – {set.end}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              <div class="schedule-day" id="sunday">
                <div class="schedule-grid">
                  <div class="schedule-stage">
                    <h3 class="stage-header stage-header--red">Red Stage</h3>
                    {sunday.red.map((set) => (
                      <div class="schedule-event">
                        <span class="event-artist">{set.artist}</span>
                        <span class="event-time">{set.start} – {set.end}</span>
                      </div>
                    ))}
                  </div>
                  <div class="schedule-stage">
                    <h3 class="stage-header stage-header--green">Green Stage</h3>
                    {sunday.green.map((set) => (
                      <div class="schedule-event">
                        <span class="event-artist">{set.artist}</span>
                        <span class="event-time">{set.start} – {set.end}</span>
                      </div>
                    ))}
                  </div>
                  <div class="schedule-stage">
                    <h3 class="stage-header stage-header--blue">Blue Stage</h3>
                    {sunday.blue.map((set) => (
                      <div class="schedule-event">
                        <span class="event-artist">{set.artist}</span>
                        <span class="event-time">{set.start} – {set.end}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <style is:inline>
    .schedule-tabs__nav {
      display: flex;
      gap: 0;
      margin-bottom: 30px;
      border-bottom: 2px solid #000;
    }
    .schedule-tab {
      background: none;
      border: none;
      padding: 12px 24px;
      font-family: GT-Cinetype-Regular, Arial, Helvetica, sans-serif;
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.10em;
      cursor: pointer;
      color: #999;
      border-bottom: 3px solid transparent;
      margin-bottom: -2px;
      transition: color 0.2s, border-color 0.2s;
    }
    .schedule-tab:hover {
      color: #333;
    }
    .schedule-tab.active {
      color: #000;
      border-bottom-color: #000;
    }
    .schedule-day {
      display: none;
    }
    .schedule-day.active {
      display: block;
    }
    .schedule-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 20px;
    }
    @media (max-width: 767px) {
      .schedule-grid {
        grid-template-columns: 1fr;
      }
    }
    .stage-header {
      font-size: 14px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.10em;
      padding: 10px 12px;
      margin: 0 0 2px 0;
      color: #fff;
    }
    .stage-header--red { background: #000; }
    .stage-header--green { background: #000; }
    .stage-header--blue { background: #000; }
    .schedule-event {
      display: flex;
      flex-direction: column;
      padding: 10px 12px;
      border-bottom: 1px solid #eee;
      background: #fafafa;
    }
    .schedule-event:hover {
      background: #f0f0f0;
    }
    .event-artist {
      font-family: GT-Cinetype-Regular, Arial, Helvetica, sans-serif;
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #000;
    }
    .event-time {
      font-family: GT-Cinetype-Regular, Arial, Helvetica, sans-serif;
      font-size: 11px;
      color: #666;
      margin-top: 2px;
      letter-spacing: 0.05em;
    }
  </style>

  <script is:inline>
    document.querySelectorAll('.schedule-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.schedule-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.schedule-day').forEach(d => d.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById(tab.dataset.day).classList.add('active');
      });
    });
  </script>
</Flora2015Layout>
