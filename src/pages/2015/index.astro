---
import Flora2015Layout from '@layouts/Flora2015Layout.astro';
import ArtistGrid from '@components/ArtistGrid.astro';
import snapshotData from '@data/snapshot-2015.json';
import { SOCIAL_LINKS } from '@data/site-config';
---

<Flora2015Layout title="line up" bodyClass="home page page-id-11 classic-nav no-title">
  <div class="main-content full-width header-space">
    <div class="page-background" style="background-color: #ffffff;"></div>

    <!-- Hero section -->
    <section class="w-section w-full">
      <div class="container">
        <div class="row">
          <div class="col col-12">
            <div class="w-image text-center homepage-hero-img">
              <img src={`/shared-assets/2015/images/${snapshotData.heroImage}`} alt="Day For Night" />
              <h3 class="countdown-timer" id="countdown-timer"></h3>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Quicklinks -->
    <section class="w-section dfn-quicklinks--wrap">
      <div class="container">
        <div class="row">
          <div class="col col-4">
            <a class="w-link-button" href="https://dayfornight.frontgatetickets.com/" target="_blank" rel="noopener noreferrer">
              <span></span>
              Buy Tickets
            </a>
          </div>
          <div class="col col-4">
            <a class="w-link-button" href="/2015/schedule/">
              <span></span>
              Schedule
            </a>
          </div>
          <div class="col col-4">
            <a class="w-link-button" href="/2015/info/">
              <span></span>
              Info
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Social tagline -->
    <section class="w-section no-padding w-v-align w-middle">
      <div class="container">
        <div class="row">
          <div class="col col-12 sub-title-wrap">
            <div class="w-text-block">
              <h3 class="p1" style="text-align: center;">
                <span class="s1">{snapshotData.subtitle} &nbsp; &nbsp; &nbsp;<span class="images"><a href={SOCIAL_LINKS.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><i class="flora-icon-github" style="font-size:38px; line-height:38px;"></i></a>&nbsp;<a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener noreferrer"><img src="/shared-assets/2015/images/twitter.png" alt="Twitter" width="38" height="38" /></a>&nbsp;<a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer"><img src="/shared-assets/2015/images/instagram.png" alt="Instagram" width="38" height="38" /></a>&nbsp;<a href={SOCIAL_LINKS.spotify} target="_blank" rel="noopener noreferrer"><img src="/shared-assets/2015/images/spotify.png" alt="Spotify" width="38" height="38" /></a></span></span>
              </h3>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Artist grid -->
    <section class="w-section s-padding">
      <div class="container">
        <div class="row">
          <div class="col col-12">
            <ArtistGrid items={snapshotData.gridOrder.filter(i => i.cssClass === 'musicians')} />
            <h2 class="visual-artists-heading">VISUAL ARTISTS:</h2>
            <ArtistGrid items={snapshotData.gridOrder.filter(i => i.cssClass === 'artists')} />
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    // Countdown display (matches original snapshot)
    const days = Math.floor(Math.random() * 30) + 1;
    const el = document.getElementById('countdown-timer');
    if (el) {
      el.textContent = `${days} Days until Day for Night`;
    }
  </script>
</Flora2015Layout>
