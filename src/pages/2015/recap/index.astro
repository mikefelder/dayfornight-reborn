---
import Flora2015Layout from '@layouts/Flora2015Layout.astro';
import recapData from '@data/recap-2015.json';
---

<Flora2015Layout title="Recap" bodyClass="home page page-template recap-page" extraStylesheets={["/shared-assets/2015/css/recap.css"]}>

  <div class="main-content full-width header-space">
    <div class="page-background" style="background-color:#ffffff"></div>

    <!-- Hero Video -->
    <section class="w-section w-full vc_custom_1447863533459">
      <div class="container">
        <div class="row">
          <div class="col col-12">
            <section class="video-js-wrapper">
              <div class="video-js-responsive-container vjs-hd">
                <video autoplay loop muted playsinline preload="auto">
                  <source src={recapData.heroVideo} type="video/mp4" />
                </video>
              </div>
              <a href={recapData.heroYouTubeUrl} target="_blank" rel="noopener noreferrer">
                <span class="w-media-player"></span>
              </a>
            </section>
          </div>
        </div>
      </div>
    </section>

    <!-- Tagline -->
    <section class="w-section no-padding w-v-align w-middle">
      <div class="container">
        <div class="row">
          <div class="col col-12 sub-title-wrap">
            <p class="recap-tagline">{recapData.description}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- YouTube Recap Videos -->
    <section class="w-section row-youtube">
      <div class="container">
        <div class="row">
          {recapData.recapVideos.map((video) => (
            <div class="col col-4">
              <a href={video.youtubeUrl} target="_blank" rel="noopener noreferrer" class="video-thumb">
                <img src={video.thumbnail} alt={video.title} />
                <span class="w-media-player-play"></span>
              </a>
              <p class="video-title">{video.title}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Press -->
    <section class="press">
      <div class="container">
        <div class="row">
          <div class="col col-12">
            <h2 class="h2">Press</h2>
          </div>
        </div>
        <div class="row">
          <div class="col col-12 press-row">
            {recapData.press.slice(0, 4).map((item) => (
              <a href={item.url} title={item.name} target="_blank" rel="noopener noreferrer">
                <img src={item.image} alt={item.name} style={`width:${item.width}`} />
              </a>
            ))}
          </div>
        </div>
        <div class="row">
          <div class="col col-12 press-row">
            {recapData.press.slice(4).map((item) => (
              <a href={item.url} title={item.name} target="_blank" rel="noopener noreferrer">
                <img src={item.image} alt={item.name} style={`width:${item.width}`} />
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Performers / Lineup -->
    <section class="performers">
      <div class="container">
        <div class="row">
          <div class="col col-12">
            <h2 class="h2">2015 Lineup</h2>
          </div>
        </div>
        <div class="row">
          <div class="col col-12">
            <h4 class="h4">Musicians</h4>
            <div class="lineup-list">
              {recapData.musicians.map((artist, i) => (
                <>
                  <a href={`/2015/artists/${artist.slug}/`}>{artist.name}</a>
                  {i < recapData.musicians.length - 1 && <span class="bullet">&middot;</span>}
                </>
              ))}
            </div>
          </div>
        </div>
        <div class="row">
          <div class="col col-12">
            <h4 class="h4">Artists</h4>
            <div class="lineup-list">
              {recapData.artists.map((artist, i) => (
                <>
                  <a href={`/2015/artists/${artist.slug}/`}>{artist.name}</a>
                  {i < recapData.artists.length - 1 && <span class="bullet">&middot;</span>}
                </>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Flora2015Layout>
